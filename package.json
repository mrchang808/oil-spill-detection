{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "import:dartis:dry": "node --loader ts-node/esm src/scripts/import-dartis-csv.ts --dry-run",
    "import:dartis": "node --loader ts-node/esm src/scripts/import-dartis-csv.ts",
    "neft-dashlari": "node --loader ts-node/esm src/scripts/run-neft-dashlari-pipeline.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.81.1",
    "browserslist": "^4.27.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.9.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.21",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/ui": "^3.0.0",
    "autoprefixer": "^10.4.18",
    "baseline-browser-mapping": "^2.9.16",
    "dotenv": "^17.2.3",
    "eslint": "9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4",
    "typescript-eslint": "8.8.1",
    "vite": "^7.1.12",
    "vitest": "^3.0.0"
  }
}
